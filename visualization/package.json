{
  "name": "raid-defense-visualization",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/raid-defense-wasm --release --target web --out-dir ../../visualization/src/generated/raid-defense-wasm --out-name raid_defense_wasm",
    "build:wasm:dev": "wasm-pack build ../crates/raid-defense-wasm --dev --target web --out-dir ../../visualization/src/generated/raid-defense-wasm --out-name raid_defense_wasm",
    "predev": "bun run build:wasm:dev",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "bun run build:wasm && bun run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "i18n:check": "bun src/localization.check.ts",
    "lint": "bun run i18n:check && bunx oxlint@1.80.0 src e2e test --format=github",
    "test:unit": "bun test ./test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@moritzbrantner/i18n": "^0.1.0",
    "@moritzbrantner/settings-browser": "github:moritzbrantner/settings#007b4405d2aaa5d765eea87abd813c8dd1c3e1be",
    "@moritzbrantner/ui": "https://registry.npmjs.org/@moritzbrantner/ui/-/ui-1.1.0.tgz",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
