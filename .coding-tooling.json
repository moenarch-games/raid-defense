{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": [
      "format:check",
      "lint",
      "build",
      "test:unit"
    ],
    "integration": [
      "test:integration"
    ],
    "e2e": [
      "test:e2e"
    ],
    "performance": [
      "benchmark:smoke",
      "performance:work"
    ]
  },
  "requiredCapabilities": [
    "format:check",
    "lint",
    "build",
    "test:unit",
    "benchmark:smoke",
    "performance:work"
  ],
  "optionalCapabilities": [
    "test:integration",
    "test:e2e"
  ],
  "capabilityCommands": {
    ".": {
      "benchmark:smoke": [
        "bash",
        "scripts/performance-smoke.sh"
      ],
      "performance:work": [
        "bash",
        "scripts/performance-work.sh"
      ]
    }
  },
  "merge": {
    "authority": "hosted",
    "requiredChecks": [
      "merge-ready"
    ]
  }
}
